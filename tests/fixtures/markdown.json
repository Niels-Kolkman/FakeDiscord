    {
        "name": "underline",
        "input": "__underlined__",
        "html": "<u>underlined</u>"
    },
    {
        "name": "strikethrough",
        "input": "~~gone~~",
        "html": "<s>gone</s>"
    },
    {
        "name": "bold italic",
        "input": "***both***",
        "html": "<strong><em>both</em></strong>"
    },
    {
        "name": "nested",
