    {
        "name": "snake_case stays text",
        "input": "call some_function_name now",
        "html": "call some_function_name now"
    },
    {
        "name": "underscore inside a word",
        "input": "_not_italic",
        "html": "_not_italic"
    },
    {
        "name": "lone stars",
        "input": "2 * 3 * 4 = 24",
        "html": "2 * 3 * 4 = 24"
    },
    {
        "name": "unclosed bold",
        "input": "**not closed",
        "html": "**not closed"
    },
    {
        "name": "escaped stars",
        "input": "\\*not italic\\*",
        "html": "*not italic*"
    },
    {
        "name": "backslash before a letter is kept",
        "input": "C:\\temp\\new",
        "html": "C:\\temp\\new"
    },
    {
        "name": "inline code",
        "input": "run `npm test` please",
        "html": "run <code>npm test</code> please"
    },
    {
        "name": "inline code is not formatted",
        "input": "`**not bold** <b>`",
        "html": "<code>**not bold** &lt;b&gt;</code>"
    },
    {
        "name": "double backtick code",
        "input": "``a ` b``",
        "html": "<code>a ` b</code>"
    },
    {
        "name": "code block",
        "input": "```\nconst a = 1;\n```",
        "html": "<pre><code>const a = 1;</code></pre>"
    },
    {
        "name": "code block with a language",
        "input": "```js\nconsole.log('<hi>');\n```",
        "html": "<pre><code data-language=\"js\">console.log(&#039;&lt;hi&gt;&#039;);</code></pre>"
    },
    {
        "name": "one line code block",
        "input": "```hello world```",
        "html": "<pre><code>hello world</code></pre>"
    },
    {
        "name": "code block between text",
        "input": "before\n```\ncode\n```\nafter",
        "html": "before<pre><code>code</code></pre>after"
    },
    {
        "name": "code block keeps markdown",
        "input": "```\n**x** _y_ https://example.com\n```",
        "html": "<pre><code>**x** _y_ https://example.com</code></pre>"
    },
    {
        "name": "quote",
        "input": "> quoted",
        "html": "<blockquote>quoted</blockquote>"
    },
    {
        "name": "quote lines",
        "input": "> one\n> two\nnot quoted",
        "html": "<blockquote>one\ntwo</blockquote>not quoted"
    },
    {
        "name": "quote with formatting",
        "input": "> **bold** in a quote",
        "html": "<blockquote><strong>bold</strong> in a quote</blockquote>"
    },
    {
        "name": "text then quote",
        "input": "intro\n> quoted",
        "html": "intro<blockquote>quoted</blockquote>"
    },
    {
        "name": "quote rest",
        "input": ">>> everything\nafter this\n> too",
        "html": "<blockquote>everything\nafter this\n&gt; too</blockquote>"
    },
    {
        "name": "quote needs a space",
        "input": ">not a quote",
        "html": "&gt;not a quote"
    },
    {
        "name": "quote only at the start of a line",
        "input": "a > b",
        "html": "a &gt; b"
    },
    {
        "name": "no nested quotes",
        "input": "> > inner",
        "html": "<blockquote>&gt; inner</blockquote>"
    },
    {
        "name": "url",
        "input": "see https://example.com/path?q=1&r=2 now",
        "html": "see <a href=\"https://example.com/path?q=1&amp;r=2\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://example.com/path?q=1&amp;r=2</a> now"
    },
    {
        "name": "url trailing punctuation",
        "input": "Visit https://example.com.",
        "html": "Visit <a href=\"https://example.com\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://example.com</a>."
    },
    {
        "name": "url in brackets",
        "input": "(https://example.com/a)",
        "html": "(<a href=\"https://example.com/a\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://example.com/a</a>)"
    },
    {
        "name": "url in bold",
        "input": "**https://example.com**",
        "html": "<strong><a href=\"https://example.com\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://example.com</a></strong>"
    },
    {
        "name": "autolink",
        "input": "<https://example.com/x>",
        "html": "<a href=\"https://example.com/x\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://example.com/x</a>"
    },
    {
        "name": "http url",
        "input": "http://example.com",
        "html": "<a href=\"http://example.com\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">http://example.com</a>"
    },
    {
        "name": "url with a quote",
        "input": "https://example.com/\"onmouseover=\"alert(1)",
        "html": "<a href=\"https://example.com/&quot;onmouseover=&quot;alert(1\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://example.com/&quot;onmouseover=&quot;alert(1</a>)"
    },
    {
        "name": "javascript url is text",
        "input": "javascript:alert(1)",
        "html": "javascript:alert(1)"
