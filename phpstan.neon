includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-mockery/extension.neon

parameters:
    level: 6

    # Laravel's Seeder::$command is documented as a non-null Command but is
    # unset when a seeder runs outside artisan; don't trust PHPDoc-only types.
    treatPhpDocTypesAsCertain: false

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - tests

    # Pest's test closures run as Tests\FeatureTestCase (tests/Pest.php).
    stubFiles:
        - tests/stubs/pest.stub

    tmpDir: storage/framework/cache/phpstan
